#!/usr/bin/env python3
"""Combine every ai-usagebar account into ONE waybar module.

Bar:   tiny "<icon><tag> <pct>%" per account (tag = d/h/d/w), colored by that
       account's OVERALL severity (so a hot account reads red even if its 5h
       window is low).
Hover: one compact line per account — label · plan · 5h% · 7d% · scoped · reset.

ai-usagebar is one-account per call, so this fans out and merges. The color of
each account comes from ai-usagebar's own text span (theme-correct); the values
come from a pipe-delimited --tooltip-format. Second accounts (claude-hello,
codex-work) are included only once their credential file exists.
"""
import json
import os
import re
import subprocess

HOME = os.path.expanduser("~")
ACC = os.path.join(HOME, ".config", "ai-usagebar", "accounts")
BIN = os.path.join(HOME, ".cargo", "bin", "ai-usagebar")
if not os.path.exists(BIN):
    BIN = "ai-usagebar"

DIM = "#727169"
BARSEP = " <span foreground='#585858'>·</span> "
COLOR_RE = re.compile(r"foreground='(#[0-9A-Fa-f]{6})'")
SEV = {"low": 0, "mid": 1, "high": 2, "critical": 3}
SEV_NAME = {v: k for k, v in SEV.items()}

CLA_TIP = "{session_pct}|{weekly_pct}|{session_reset}|{scoped_model}|{scoped_pct}|{plan}"
OAI_TIP = "{oai_session_pct}|{oai_weekly_pct}|{oai_session_reset}|||{oai_plan}"

# label, tag, icon, --format, --tooltip-format, extra args, extra env, creds gate
SPECS = [
    ("claude-dev", "d", "󰚩", "{session_pct}", CLA_TIP, ["--vendor", "anthropic"], None, None),
    ("claude-hello", "h", "󰚩", "{session_pct}", CLA_TIP,
     ["--vendor", "anthropic", "--account", "hello"], None, f"{ACC}/claude-hello.json"),
    ("codex-dev", "d", "󱢆", "{oai_session_pct}", OAI_TIP, ["--vendor", "openai"], None, None),
    ("codex-work", "w", "󱢆", "{oai_session_pct}", OAI_TIP,
     ["--vendor", "openai", "--cache-dir", f"{HOME}/.cache/ai-usagebar/openai-work"],
     {"XDG_CONFIG_HOME": f"{HOME}/.config/ai-usagebar-codex-work"}, f"{ACC}/codex-work/auth.json"),
]


def query(fmt, tipfmt, args, env):
    environ = os.environ.copy()
    environ["PATH"] = os.path.join(HOME, ".cargo", "bin") + ":" + environ.get("PATH", "")
    if env:
        environ.update(env)
    cmd = [BIN, *args, "--format", fmt, "--tooltip-format", tipfmt, "--json"]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, env=environ, timeout=30)
    except Exception:
        return None
    out = proc.stdout.strip()
    if not out:
        return None
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return None


bars, tips, worst = [], [], 0
for label, tag, icon, fmt, tipfmt, args, env, gate in SPECS:
    if gate and not os.path.exists(gate):
        continue
    data = query(fmt, tipfmt, args, env)
    if not data:
        continue
    match = COLOR_RE.search(data.get("text", ""))
    color = match.group(1) if match else "#dcd7ba"
    fields = (data.get("tooltip", "") or "").split("|")
    fields += [""] * (6 - len(fields))
    sess, week, reset, model, scoped, plan = (f.strip() for f in fields[:6])
    sess = sess or "0"
    week = week or "0"
    reset = reset or "—"

    bars.append(f"<span foreground='{color}'>{icon} {tag} {sess}%</span>")

    scoped_part = f"  ·  {model} {scoped}%" if model else ""
    tips.append(
        f"<span foreground='{color}'>{label.ljust(12)}</span> "
        f"<span foreground='{DIM}'>{plan.ljust(15)}</span> "
        f"5h {sess.rjust(3)}%  ·  7d {week.rjust(3)}%{scoped_part}  "
        f"<span foreground='{DIM}'>⟳ {reset}</span>"
    )
    worst = max(worst, SEV.get(data.get("class", ""), 0))

header = "<span foreground='#957fb8' font_weight='bold'>ai-usagebar</span>"
print(
    json.dumps(
        {
            "text": BARSEP.join(bars),
            "tooltip": header + "\n" + "\n".join(tips) if tips else "",
            "class": SEV_NAME.get(worst, "low"),
        }
    )
)
