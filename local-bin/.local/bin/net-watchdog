#!/usr/bin/env bash
# Restarts networking when this machine loses its router. Run every minute by net-watchdog.timer
# (installed by proart-server-setup). Read: journalctl -t net-watchdog
#
# - Router reachable but internet down (ISP outage): logs only, so LAN and tailnet sessions stay up.
# - Router unreachable: restarts NetworkManager every 3rd failed check, toggles the Wi-Fi radio
#   every 10th. It never reboots: the disk needs a passphrase after a reboot.
set -uo pipefail

STATE=/run/net-watchdog.fails
fails="$(cat "$STATE" 2>/dev/null || echo 0)"

log() { logger -t net-watchdog "$*"; }

reachable() {
  ping -c 1 -W 3 "$1" >/dev/null 2>&1
}

internet_up() {
  reachable 1.1.1.1 || reachable 8.8.8.8
}

if internet_up; then
  if [ "$fails" -gt 0 ]; then
    log "online again after $fails failed check(s)"
  fi
  echo 0 >"$STATE"
  exit 0
fi

gateway="$(ip route show default 2>/dev/null | awk '{ print $3; exit }')"
if [ -n "$gateway" ] && reachable "$gateway"; then
  log "internet down, router $gateway reachable: waiting for the ISP"
  echo 0 >"$STATE"
  exit 0
fi

fails=$((fails + 1))
echo "$fails" >"$STATE"
log "router ${gateway:-none} unreachable ($fails)"

if [ $((fails % 10)) -eq 0 ]; then
  log "toggling the Wi-Fi radio"
  nmcli radio wifi off
  sleep 3
  nmcli radio wifi on
  exit 0
fi

if [ $((fails % 3)) -eq 0 ]; then
  log "restarting NetworkManager"
  systemctl restart NetworkManager
fi
