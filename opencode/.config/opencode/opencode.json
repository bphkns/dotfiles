{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["~/.agents/skills", "~/.claude/skills"]
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}",
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    "uidotsh": {
      "type": "remote",
      "url": "https://ui.sh/mcp?agent=opencode",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:UIDOTSH_TOKEN}"
      }
    }
  },
  "provider": {
    "fireworks-ai": {
      "options": {
        "apiKey": "{env:FIREWORKS_API_KEY}"
      }
    },
    "google-vertex-anthropic": {
      "options": {
        "project": "ai-exps",
        "location": "global",
        "googleAuthOptions": {
          "keyFilename": "{env:OPENCODE_VERTEX_CREDENTIALS}"
        }
      },
      "models": {
        "claude-fable-5": {
          "name": "Claude Fable 5",
          "reasoning": true,
          "tool_call": true,
          "cost": {
            "input": 10,
            "output": 50
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    }
  },
  "experimental": {
    "openTelemetry": true
  },
  "autoshare": false,
  "autoupdate": false,
  "plugin": ["@ex-machina/opencode-anthropic-auth"],
  "instructions": ["/home/bikash/.config/opencode/instructions/global.md"]
}
