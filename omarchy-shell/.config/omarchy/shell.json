{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "njpatel.omapager"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.microphone"
        }
      ],
      "left": [
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.active-window"
        },
        {
          "id": "omarchy.menu"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.jhaney3.bluetooth-modes"
        },
        {
          "id": "io.github.mb-jambon.omapods"
        },
        {
          "id": "daferia.lid-sleep"
        },
        {
          "id": "io.github.omarchy-asus.panel"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "renanmt.switch-magic"
    },
    {
      "id": "io.github.smoothpixels.lock-designs"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "io.github.smoothpixels.lock-designs"
  ]
}
