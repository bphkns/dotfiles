{
  "lastChangelogVersion": "1.5.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "xhigh",
  "collapseChangelog": true,
  "enableInstallTelemetry": true,
  "autocompleteMaxVisible": 8,
  "editorPaddingX": 1,
  "doubleEscapeAction": "tree",
  "shellCommandPrefix": "source ~/.pi/agent/shell.bash",
  "npmCommand": [
    "mise",
    "exec",
    "node@25",
    "--",
    "npm"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-powerline-footer",
    "npm:@sherif-fanous/pi-rtk",
    "npm:teach-me",
    "npm:@dietrichgebert/ponytail",
    "npm:@ff-labs/pi-fff",
    "npm:pi-context-view",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-goal",
    "npm:pi-mcp-adapter@3.3.0",
    "npm:pi-annotate",
    "npm:pi-markdown-preview"
  ],
  "theme": "dark",
  "hideThinkingBlock": true,
  "modelThinkingLevels": {
    "openai-codex/gpt-5.6-sol": "xhigh"
  },
  "skills": [
    "+skills/zoom-out/SKILL.md"
  ],
  "images": {
    "blockImages": true
  },
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenScrollbar": "auto",
  "treeFilterMode": "all",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.46.0",
    "{\"source\":\"npm:pi-powerline-footer\",\"scope\":\"user\"}": "0.22.0",
    "{\"source\":\"npm:@sherif-fanous/pi-rtk\",\"scope\":\"user\"}": "0.7.0",
    "{\"source\":\"npm:pi-mcp-adapter@3.3.0\",\"scope\":\"user\"}": "3.3.0",
    "{\"source\":\"npm:pi-annotate\",\"scope\":\"user\"}": "0.5.2"
  }
}